# Copiar para /etc/econexo/backend.env no servidor
# sudo mkdir -p /etc/econexo && sudo chmod 750 /etc/econexo
# sudo chmod 600 /etc/econexo/backend.env
# sudo chown econexo:econexo /etc/econexo/backend.env

# --- Banco MySQL (mesmo VPS) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=Econexo
DB_USER=econexo_app
DB_PASS=TROQUE_POR_UMA_SENHA_FORTE

# --- CORS: domínios autorizados a chamar a API ---
# Como nginx serve front e back no mesmo host, normalmente isso aqui pode ficar vazio
# (chamadas são same-origin). Preencha só se hospedar o front em outro domínio.
APP_ALLOWED_ORIGINS=https://seudominio.com,https://www.seudominio.com

# --- Porta do Spring Boot (nginx encaminha de 80/443 -> 8080) ---
SERVER_PORT=8080
