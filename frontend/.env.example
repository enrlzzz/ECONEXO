# Copie para .env.local e preencha. NUNCA commite .env / .env.local.

# Backend. Em dev o proxy do Vite já encaminha /api para localhost:8080,
# então pode ficar vazio.
VITE_API_URL=

# Firebase Authentication — só login. Console do Firebase > Configurações
# do projeto > Seus apps > App da Web > "Configuração do SDK".
# O projectId PRECISA ser o mesmo de FIREBASE_PROJECT_ID no backend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Opcional, só em dev: usar o emulador local do Auth em vez do projeto real.
# Ex.: VITE_FIREBASE_AUTH_EMULATOR=http://127.0.0.1:9099
VITE_FIREBASE_AUTH_EMULATOR=
